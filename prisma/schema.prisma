datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model ContactSubmission {
  id                 String   @id @default(cuid())
  name               String
  email              String
  message            String
  company            String?
  phone              String?
  service            String?
  industry           String?  
  volume             String?   
  contactPreference  String?   
  privacy            Boolean   @default(false)
  createdAt          DateTime @default(now())

}


